# Copy this file to `.env.local` and fill in local values.
# Never commit `.env`, `.env.local`, or `.env.*.local`.
#
# NEXT_PUBLIC_* variables are client-safe (browser).
# All other variables are server-only and must never reach the client.
# Database credentials, session secrets, and email API keys belong in
# `apps/server/.env`, not in the Next.js web app.
#
# Production: use HTTPS origins with no trailing path.
# Docker Compose (local only) also reads these names from the host environment.
# See docs/DEPLOYMENT.md.

# Origin of the Neatly HTTP API used by the Next.js auth BFF.
# required | server-only
# Local default matches apps/server PORT when unset (4000).
# Production must be the HTTPS API origin.
NEATLY_API_URL=http://127.0.0.1:4000

# Public canonical site URL, for example https://example.com
# required | client-safe
# Production must be the HTTPS frontend origin. No trailing path.
NEXT_PUBLIC_SITE_URL=
