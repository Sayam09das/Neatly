# Copy this file to `.env.local` and fill in local values.
# Never commit `.env`, `.env.local`, or `.env.*.local`.
#
# NEXT_PUBLIC_* variables are client-safe (browser).
# All other variables are server-only and must never reach the client.

# PostgreSQL connection URL.
# required | server-only
DATABASE_URL=

# Secret used to hash admin session tokens. Use at least 32 characters.
# required | server-only
SESSION_SECRET=

# API key for the transactional email provider.
# required | server-only
EMAIL_API_KEY=

# API key for object storage.
# required | server-only
STORAGE_API_KEY=

# Public canonical site URL, for example https://neatly.example.
# required | client-safe
NEXT_PUBLIC_SITE_URL=
