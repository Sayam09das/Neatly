# Copy this file to `.env` and fill in local values.
# Never commit `.env`, `.env.local`, or `.env.*.local`.
#
# These variables belong to the backend HTTP API only.
# Never prefix them with NEXT_PUBLIC_ or import them into the Next.js client.
# Docker Compose (local only) reads the same names from the host environment.
# Do not commit filled values. See docs/DEPLOYMENT.md.

# Runtime
# NODE_ENV is required as production on the API host.
# PORT is host-defined (default 4000). HOST defaults to 0.0.0.0.
# optional locally | required in production | server-only
NODE_ENV=
PORT=
HOST=

# PostgreSQL / Prisma
# required | server-only
# DATABASE_URL is the application connection (Supabase pooler in hosted environments).
# DIRECT_URL is the direct Postgres connection used by Prisma migrate.
DATABASE_URL=
DIRECT_URL=

# Supabase (loaded in a later backend phase)
# required later | server-only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_SERVICES_THUMB_BUCKET=Services_Thumb

# Session / auth secrets
# required | server-only
SESSION_SECRET=

# Public site origin used in password-reset and verification emails.
# required | server-only
# Production must be the HTTPS frontend origin. No trailing path.
SITE_URL=

# Explicit browser origin allowed for credentialed CORS.
# required in production | server-only
# Falls back to SITE_URL, then NEXT_PUBLIC_SITE_URL, if unset.
# Must be the real frontend origin. HTTPS in production.
# Origin only: no path, no trailing slash. Example format: https://example.com
CORS_ORIGIN=

# Brevo SMTP via Nodemailer (required in production).
# SMTP_PASSWORD is the Brevo SMTP key, not a Brevo HTTP API key.
# Do not set BREVO_API_KEY for sending.
# required in production | server-only
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Neatly

# Object storage (loaded in a later backend phase)
# required later | server-only
STORAGE_API_KEY=

# Development seed only. Do not set on production hosts.
# pnpm db:seed is blocked when NODE_ENV=production.
# optional | server-only | local/controlled setup only
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SEED_PASSWORD=
