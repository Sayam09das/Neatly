{
  "name": "@neatly/web",
  "version": "0.0.0",
  "private": true,
  "description": "Neatly Next.js web application.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neatly/config": "workspace:*",
    "@neatly/ui": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:"
  }
}
