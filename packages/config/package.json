{
  "name": "@neatly/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared application configuration for Neatly.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/env.server.ts",
      "default": "./src/env.server.ts"
    },
    "./client": {
      "types": "./src/env.client.ts",
      "default": "./src/env.client.ts"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "default": "./src/zod.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
