{
  "name": "neatly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.13.1"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@neatly/config": "workspace:*",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
